# Copy to .env on the server and fill with REAL values. Never commit real secrets.

# TimescaleDB (storage #2). Use a LEAST-PRIVILEGE role (INSERT/SELECT on readings only).
TSDB_DSN=host=localhost port=5432 dbname=aqms user=aqms_ingest password=change-me sslmode=require

# MQTT broker (same broker the logger publishes to).
MQTT_HOST=broker.example.com
MQTT_PORT=8883
MQTT_USERNAME=aqms_ingest
MQTT_PASSWORD=change-me
MQTT_TLS_CA=/etc/aqms/certs/ca.crt
MQTT_TLS_CERT=
MQTT_TLS_KEY=
