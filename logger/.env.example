# Copy to .env and fill with REAL values on the station PC.
# Referenced from config.yaml as ${VAR}. Never commit this file with real values.

# --- MQTT broker (server, reached via Cloudflare tunnel as WSS) ---
# host / port / username / transport are set in config.yaml; only the password is a secret.
MQTT_PASSWORD=change-me       # the aqms_station user's password (created on the server broker)

# Redis is written by the SERVER ingest, not the logger — no Redis vars needed here.

# --- Phase 5: AQMS-Plus MySQL (Option A) — leave until the FPI source is decided ---
FPI_MYSQL_HOST=
FPI_MYSQL_PORT=3306
FPI_MYSQL_DB=
FPI_MYSQL_USER=
FPI_MYSQL_PASSWORD=
