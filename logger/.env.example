# Copy to .env and fill with REAL values on the station PC.
# Referenced from config.yaml as ${VAR}. Never commit this file with real values.

# --- MQTT broker (already provisioned on the server, TLS + auth) ---
MQTT_HOST=broker.example.com
MQTT_PORT=8883
MQTT_USERNAME=aqms_station
MQTT_PASSWORD=change-me
# Absolute path to the broker CA certificate on the station PC:
MQTT_TLS_CA=C:/aqms/certs/ca.crt
# Optional client cert/key for mTLS (leave blank if not used):
MQTT_TLS_CERT=
MQTT_TLS_KEY=

# --- Redis live cache (optional; referenced from config.yaml as ${REDIS_PASSWORD}) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Phase 5: AQMS-Plus MySQL (Option A) — leave until the FPI source is decided ---
FPI_MYSQL_HOST=
FPI_MYSQL_PORT=3306
FPI_MYSQL_DB=
FPI_MYSQL_USER=
FPI_MYSQL_PASSWORD=
