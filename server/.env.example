# Copy to server/.env and fill with REAL secrets. docker-compose reads this automatically.
# Never commit the real .env.

AQMS_DB_PASSWORD=change-me-db
AQMS_REDIS_PASSWORD=change-me-redis

# MQTT user passwords (also used when you create the mosquitto users — see README)
AQMS_MQTT_INGEST_PASSWORD=change-me-ingest
AQMS_MQTT_STATION_PASSWORD=change-me-station

# Cloudflare Tunnel token for the dedicated AQMS tunnel (Zero Trust → Tunnels → create → copy token)
AQMS_TUNNEL_TOKEN=paste-cloudflare-tunnel-token-here
