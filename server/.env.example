
# Copy to server/.env and fill with REAL secrets. docker-compose reads this automatically.
# Never commit the real .env.

AQMS_DB_PASSWORD=change-me-db
AQMS_REDIS_PASSWORD=change-me-redis

# MQTT user passwords (also used when you create the mosquitto users — see README)
AQMS_MQTT_INGEST_PASSWORD=change-me-ingest
AQMS_MQTT_STATION_PASSWORD=change-me-station

# Cloudflare Tunnel token for the dedicated AQMS tunnel (Zero Trust → Tunnels → create → copy token)
AQMS_TUNNEL_TOKEN=paste-cloudflare-tunnel-token-here

# --- aqms-watchdog: alerts (../watchdog/README.md). Fill Telegram and/or email. ---
# station_id from the logger's config.yaml, and a friendly name for the alerts (optional)
AQMS_STATION_ID=example_station_id
AQMS_STATION_NAME=
# Same bot + SMTP2GO account as the dashboard: copy these from the dashboard's env
#   docker exec aqms-web-api printenv | grep -E 'TELEGRAM|SMTP'
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SMTP_PASSWORD, or SMTP_PASS as the dashboard names it - either works
SMTP_PASS=
# a sender address on a domain verified in SMTP2GO (Sending -> Verified Senders)
SMTP_FROM=
# Who gets the watchdog alerts (several: comma separated). A Telegram chat id is the one in
# the dashboard's notification settings, or a group id (starts with -).
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
